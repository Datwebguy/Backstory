# HydraDB OSS (docker compose)
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_BOLT_URL=bolt://127.0.0.1:7687
HYDRA_ADMIN_URL=http://127.0.0.1:9090
HYDRA_TOKEN=backstory-local-dev-token-32bytes!
HYDRA_NAMESPACE=default
HYDRA_GRAPH_ID=default
HYDRA_CELL_ID=cell-0

# Sidecar
BACKSTORY_DATA_DIR=./runs/local

# LLM (optional for extraction/answering; smoke tests do not require it)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BACKSTORY_EXTRACT_MODEL=gpt-4o-mini
BACKSTORY_ANSWER_MODEL=gpt-4o-mini
BACKSTORY_EMBED_MODEL=text-embedding-3-small
BACKSTORY_JUDGE_MODEL=gpt-4o
