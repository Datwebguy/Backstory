# HydraDB OSS (docker compose)
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_BOLT_URL=bolt://127.0.0.1:7687
HYDRA_ADMIN_URL=http://127.0.0.1:9090
HYDRA_TOKEN=backstory-local-dev-token-32bytes!
HYDRA_NAMESPACE=default
HYDRA_GRAPH_ID=default
HYDRA_CELL_ID=cell-0

# Sidecar
BACKSTORY_DATA_DIR=./runs/local

# LLM (optional for extraction/answering; smoke tests do not require it,
# tests/*.py explicitly force this off so they stay hermetic regardless
# of what is set here). Any OpenAI-compatible endpoint works, not only
# OpenAI itself -- for example NVIDIA's NIM catalog:
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   BACKSTORY_EXTRACT_MODEL=openai/gpt-oss-20b
#   BACKSTORY_ANSWER_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BACKSTORY_EXTRACT_MODEL=gpt-4o-mini
BACKSTORY_ANSWER_MODEL=gpt-4o-mini
BACKSTORY_EMBED_MODEL=text-embedding-3-small
# The official LongMemEval judge (vendor/longmemeval/evaluate_qa.py) is
# separate from the two models above and only accepts gpt-4o, gpt-4o-mini,
# or a self-hosted llama-3.1-70b-instruct; it does not read this value.
BACKSTORY_JUDGE_MODEL=gpt-4o

# Google sign-in (required for /app -- every API call needs an
# authenticated session; see https://console.cloud.google.com/
# OAuth consent screen + Web application client, redirect URI
# http://127.0.0.1:8000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string; must stay constant
# across restarts or existing sessions are invalidated. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
