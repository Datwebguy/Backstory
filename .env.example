# Copy to .env. Docker Compose reads it automatically.

# Optional: OpenAI-compatible key. Required for official LongMemEval
# evaluate_qa.py gpt-4o, and for LLM extract/answer. Without it the
# heuristic extractor and template answerer still run.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

# Long local HydraDB runs (LME 500 / BEAM). Leave unset to keep
# CLOUD_PROVIDER=local for short smoke/demo work. hydra-db/hydradb#81
# will kill a long ingest on local FS.
# CLOUD_PROVIDER=aws
# AWS_BUCKET=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
